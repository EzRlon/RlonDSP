# ==========================================================
# RlonDSP 版本库忽略规则
# 说明：只排除依赖、构建产物、打包产物与临时文件，
#       源码、文档、上游参考源码与许可证文件均保留入库。
# ==========================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建与打包产物（仅限项目根目录，避免波及上游参考源码） ----------
/dist/
/build/
/release/
/out/
/coverage/
*.tsbuildinfo

# ---------- 上游运行时与依赖快照（体积大，按需本地准备） ----------
vendor/echomusic/runtime/
vendor/echomusic/app-src/node_modules/

# ---------- 日志与临时文件 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.orig
*.pid
*_pid.txt
run_out.txt
run_err.txt
test-log.txt

# ---------- 本地环境与密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- 编辑器与系统文件 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo

# ---------- 本地备份（体积大，不入库） ----------
backup/
backup-*/
*backup*/
*.zip
